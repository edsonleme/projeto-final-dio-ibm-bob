# =============================================================
#  .gitignore — projeto-final-dio-ibm-bob
#  Genérico, cobrindo as principais linguagens e ferramentas.
# =============================================================

# -------------------------------------------------------------
# Sistema Operacional
# -------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# -------------------------------------------------------------
# Editores e IDEs
# -------------------------------------------------------------
# VSCode
.vscode/
!.vscode/extensions.json

# JetBrains (IntelliJ, WebStorm, PyCharm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Eclipse
.classpath
.project
.settings/

# Vim / Neovim
*.swp
*.swo
Session.vim

# Emacs
\#*\#
.\#*

# -------------------------------------------------------------
# Node.js / JavaScript / TypeScript
# -------------------------------------------------------------
node_modules/
dist/
build/
.next/
.nuxt/
.cache/
.parcel-cache/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# -------------------------------------------------------------
